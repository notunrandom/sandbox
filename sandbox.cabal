cabal-version:   3.12
name:            sandbox
version:         0.1.0.0
license:         NONE
author:          Unknown
maintainer:      Unknown
build-type:      Simple
extra-doc-files: CHANGELOG.md

common settings
    ghc-options:      -Wall
    build-depends:    base ^>=4.22.0.0
    default-language: Haskell2010

library
    import:           settings
    exposed-modules:  MyLib
    hs-source-dirs:   lib

executable sandbox
    import:           settings
    main-is:          Main.hs
    build-depends:    sandbox
    hs-source-dirs:   exe

test-suite sandbox-test
    import:           settings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   tdd
    main-is:          Main.hs
    build-depends:    sandbox
