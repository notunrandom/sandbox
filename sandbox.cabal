cabal-version:        3.12
name:                 sandbox
version:              0.1.0.0
license:              Apache-2.0
license-file:         LICENSE
author:               notunrandom
maintainer:           notunrandom
build-type:           Simple

common settings

  ghc-options:      -Wall
  default-language: Haskell2010
  build-depends:
                    , base ^>=4.18.3.0
                    , base16-bytestring
                    , bytestring
                    , cborg
                    , serialise

library

  import:           settings
  hs-source-dirs:   lib
  exposed-modules:
                    , Animal
                    , CBOR
                    , Lib
                    , Shape

executable sandbox

  import:           settings
  main-is:          Main.hs
  build-depends:    sandbox
  hs-source-dirs:   exe

test-suite sandbox-test

  import:           settings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   tdd
  main-is:          Main.hs
  other-modules:
                    , LazyByteString
                    , LazyCBOR
                    , LazySerialise
  build-depends:
                    , QuickCheck
                    , sandbox
